# HMS MMA Backend Environment Variables
# Copy this file to .env and fill in your values

# ── App ─────────────────────────────────────
PROJECT_NAME=HMS MMA Backend
API_V1_STR=/api/v1
# development | production
# production refuses to boot with a placeholder/short SECRET_KEY
ENVIRONMENT=development

# ── PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hms_mma

# ── JWT ──────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Uploads ─────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── CORS ──────────────────────────────────────
# Comma separated origins, or * for any origin
CORS_ORIGINS=*

# ── Bootstrap admin (first run only) ─────────
# Created when the users table is empty; leave PASSWORD blank to skip.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# ── WhatsApp (Choose: gupshup | wati | twilio) ─
WHATSAPP_PROVIDER=gupshup
WHATSAPP_API_URL=https://api.gupshup.io/sm/api/v1/msg
WHATSAPP_API_KEY=YOUR_GUPSHUP_API_KEY
WHATSAPP_FROM_NUMBER=917000000000
# Shared secret the provider sends in X-Callback-Secret.
# While unset, delivery callbacks are rejected.
WHATSAPP_CALLBACK_SECRET=

# ── Twilio (only when WHATSAPP_PROVIDER=twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
